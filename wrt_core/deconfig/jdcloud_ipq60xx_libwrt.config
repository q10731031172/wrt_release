# ==================== 设备基础锁定(RE-SS-01) ====================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01="ipq-wifi-jdcloud_re-ss-01 ath11k-firmware-qcn9074-ddwrt kmod-ath11k-pci"
CONFIG_TARGET_ROOTFS_INITRAMFS=n

# ==================== 京东云亚瑟NSS硬件加速(必须保留) ====================
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-l2tpv2=y

# ==================== 系统内核网络优化 ====================
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-tls=y

# ==================== 文件系统支持(外接硬盘必备) ====================
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-ext4=y

# ==================== USB硬件精简保留常用 ====================
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb2=y

# ==================== 系统基础工具 ====================
CONFIG_PACKAGE_ath11k-firmware-qcn9074-ddwrt=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_fuse-utils=y
CONFIG_PACKAGE_ntfs3-mount=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_qrencode=y
CONFIG_PACKAGE_smartmontools-drivedb=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_usbmuxd=y
CONFIG_PACKAGE_mii-tool=y
CONFIG_PACKAGE_xl2tpd=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_ca-certificates=y

# ==================== 你原有插件全部保留(已优化=m→y) ====================
CONFIG_PACKAGE_luci-app-autoreboot=y                  #定时重启
CONFIG_PACKAGE_luci-app-cupsd=y                       #网络打印服务
CONFIG_PACKAGE_luci-app-diskman=y                     #磁盘管理
CONFIG_PACKAGE_luci-app-quickfile=y                   #简易文件分享
CONFIG_PACKAGE_luci-app-samba4=y                      #局域网硬盘共享
CONFIG_PACKAGE_luci-app-sqm=y                         #游戏流量队列优化
CONFIG_PACKAGE_luci-app-vlmcsd=y                      #本地KMS激活
CONFIG_PACKAGE_luci-app-athena-led=y                  #亚瑟LED指示灯控制
CONFIG_PACKAGE_luci-app-ttyd=y                        #网页SSH终端
CONFIG_PACKAGE_luci-app-filetransfer=y                #网页文件上传下载

#原有插件中文包
CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-i18n-cupsd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-quickfile-zh-cn=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y

# -------------------------- 1. Docker 容器管理（精简版） --------------------------
# 只保留核心运行时和图形界面，去掉所有冗余工具
CONFIG_PACKAGE_luci-app-dockerman=y                  # Docker图形管理
CONFIG_PACKAGE_docker-ce=y                           # Docker核心引擎
CONFIG_PACKAGE_docker-compose=y                      # Docker编排工具
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y           # 中文语言包

# 必选内核依赖（不能删）
CONFIG_PACKAGE_cgroupfs-mount=y
CONFIG_PACKAGE_kmod-cgroupfs=y
CONFIG_PACKAGE_kmod-br-netfilter=y

# -------------------------- 2. PassWall 科学上网（精简版） --------------------------
# 只保留2026年最主流的5个协议，砍掉所有冷门协议
CONFIG_PACKAGE_luci-app-passwall=y                   # PassWall主程序
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y            # 中文语言包

# 主流协议核心（99%用户只用这些）
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y      # Xray核心（VLESS/VMess/Trojan）
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y   # SingBox核心（最新通用）
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y  # Hysteria 2协议
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Tuic=y      # TUIC v5协议
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowTLS=y # ShadowTLS v3协议

# 必备工具（不能删）
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Dns2socks=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Microsocks=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Jq=y

# -------------------------- 3. SmartDNS DNS加速（精简版） --------------------------
# 去掉几乎没人用的额外功能模块，默认配置已足够
CONFIG_PACKAGE_luci-app-smartdns=y                   # SmartDNS图形界面
CONFIG_PACKAGE_smartdns=y                            # SmartDNS核心程序
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y            # 中文语言包

# -------------------------- 4. DDNS Go 动态域名（精简版） --------------------------
# 本身就很小，几乎没有可精简的，保留全部核心功能
CONFIG_PACKAGE_luci-app-ddns-go=y                    # DDNS Go图形界面
CONFIG_PACKAGE_ddns-go=y                             # DDNS Go核心程序
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y             # 中文语言包
